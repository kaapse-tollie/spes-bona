# All existing penalty stages share the same localised name. Show the actual
# timed modifier's effects, rather than duplicating its changing numbers.
flowcontainer = {
 name = sb_firearms_penalties
 parentanchor = hcenter
 direction = vertical
 ignoreinvisible = yes
 spacing = 8
 textbox = {
  text = "sb_firearms_current_penalties"
  autoresize = yes
  multiline = yes
  minimumsize = { 504 -1 }
  maximumsize = { 504 -1 }
 }
 flowcontainer = {
  direction = vertical
  ignoreinvisible = yes
  datamodel = "[JournalEntry.GetCountry.GetTimedModifiers]"
  item = {
   textbox = {
    visible = "[EqualTo_string(TimedModifier.GetName, Localize('sb_iron_age_weapons'))]"
    text = "[TimedModifier.GetDesc]"
    autoresize = yes
    multiline = yes
    minimumsize = { 504 -1 }
    maximumsize = { 504 -1 }
   }
  }
 }
}
