types sb_court_character_buttons {
 type sb_court_character_button = button_standard {
  datacontext = "[Scope.AccessCharacter]"
  enabled = "[Character.IsValid]"
  onclick = "[InformationPanelBar.OpenCharacterPanel(Character.AccessSelf)]"
  onrightclick = "[RightClickMenuManager.ShowForCharacter(Character.AccessSelf)]"
  text = "[Character.GetFullNameNoFormatting]"
  tooltipwidget = { FancyTooltip_Character = { } }

  # The whole banner owns navigation; the name must not intercept its clicks.
  buttonText = {
   text_single = {
    size = { 100% 100% }
    autoresize = no
    margin = { 10 0 }
    align = center|nobaseline
    default_format = "#clickable"
    alwaystransparent = yes
   }
  }
 }
}
