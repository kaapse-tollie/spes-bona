types sb_court_house_types {
 type sb_court_house_roster = flowcontainer {
 direction = vertical
 spacing = 8
 section_header_button = {
  size = { 504 42 }
  tooltip = "sb_court_roster_explanation"
  blockoverride "layout" { }
  blockoverride "left_text" { text = "sb_court_roster_heading" }
  blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle(Concatenate('sb_court_houses_', Country.GetIDString))]" }
  blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists(Concatenate('sb_court_houses_', Country.GetIDString)))]" }
  blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists(Concatenate('sb_court_houses_', Country.GetIDString))]" }
 }
 scrollbox = {
  name = sb_court_houses_panel
  visible = "[GetVariableSystem.Exists(Concatenate('sb_court_houses_', Country.GetIDString))]"
  size = { 504 560 }
  blockoverride "scrollbox_margins" { margin = { 10 10 } spacing = 12 }
  blockoverride "scrollbox_expand" { }
  blockoverride "scrollbox_content" {
   flowcontainer = {
    direction = vertical ignoreinvisible = yes spacing = 12
     textbox = { text = "sb_court_followings_heading" size = { 464 35 } }
     flowcontainer = {
      direction = vertical ignoreinvisible = yes spacing = 8
      datamodel = "[Country.MakeScope.GetList('sb_court_members')]"
      item = {
       flowcontainer = {
        datacontext = "[Scope.GetCharacter]"
        visible = "[And(Scope.GetCharacter.IsValid, GetScriptedGui('sb_court_roster_member').IsShown(GuiScope.SetRoot(Country.MakeScope).AddScope('sb_court_country', Country.MakeScope).AddScope('sb_court_character', Character.MakeScope).End))]"
        direction = vertical
        sb_court_character_button = {
         size = { 464 35 }
        }
        textbox = { text = "sb_court_member_summary" autoresize = yes multiline = yes minimumsize = { 464 -1 } maximumsize = { 464 -1 } }
        textbox = { text = "sb_court_roster_commitments" autoresize = yes multiline = yes minimumsize = { 464 -1 } maximumsize = { 464 -1 } }
        section_header_button = {
         size = { 464 35 }
         blockoverride "layout" { }
         blockoverride "left_text" { text = "sb_court_house_members_heading" }
         blockoverride "onclick" { onclick = "[GetVariableSystem.Toggle(Concatenate('sb_court_house_', Character.GetIDString))]" }
         blockoverride "onclick_showmore" { visible = "[Not(GetVariableSystem.Exists(Concatenate('sb_court_house_', Character.GetIDString)))]" }
         blockoverride "onclick_showless" { visible = "[GetVariableSystem.Exists(Concatenate('sb_court_house_', Character.GetIDString))]" }
        }
        flowcontainer = {
         visible = "[GetVariableSystem.Exists(Concatenate('sb_court_house_', Character.GetIDString))]"
         direction = vertical ignoreinvisible = yes spacing = 4
         datamodel = "[Character.MakeScope.GetList('sb_court_house_members')]"
         item = {
          flowcontainer = {
           datacontext = "[Scope.GetCharacter]"
           direction = vertical spacing = 2
           sb_court_character_button = {
            size = { 464 35 }
           }
           textbox = { text = "sb_court_house_member_summary" autoresize = yes multiline = yes minimumsize = { 464 -1 } maximumsize = { 464 -1 } }
           textbox = { text = "sb_court_current_roles" autoresize = yes multiline = yes minimumsize = { 464 -1 } maximumsize = { 464 -1 } }
          }
         }
        }
        textbox = { text = "sb_court_current_roles" autoresize = yes multiline = yes minimumsize = { 464 -1 } maximumsize = { 464 -1 } }
       }
      }
     }
     divider_clean = { }
     textbox = { text = "sb_court_councillors_heading" size = { 464 35 } }
     flowcontainer = {
      direction = vertical ignoreinvisible = yes spacing = 8
      datamodel = "[Country.MakeScope.GetList('sb_court_members')]"
      item = {
       flowcontainer = {
        datacontext = "[Scope.GetCharacter]"
        visible = "[And(Scope.GetCharacter.IsValid, GetScriptedGui('sb_court_roster_councillor').IsShown(GuiScope.SetRoot(Country.MakeScope).AddScope('sb_court_country', Country.MakeScope).AddScope('sb_court_character', Character.MakeScope).End))]"
        direction = vertical spacing = 4
        sb_court_character_button = {
         size = { 464 35 }
        }
        textbox = { text = "sb_court_individual_prominence" autoresize = yes multiline = yes minimumsize = { 464 -1 } maximumsize = { 464 -1 } }
        textbox = { text = "sb_court_current_roles" autoresize = yes multiline = yes minimumsize = { 464 -1 } maximumsize = { 464 -1 } }
        textbox = { text = "sb_court_roster_commitments" autoresize = yes multiline = yes minimumsize = { 464 -1 } maximumsize = { 464 -1 } }
       }
      }
     }
     divider_clean = { }
     textbox = { text = "sb_court_commanders_heading" autoresize = yes multiline = yes minimumsize = { 464 -1 } maximumsize = { 464 -1 } }
     flowcontainer = {
      direction = vertical ignoreinvisible = yes spacing = 4
      datamodel = "[Country.MakeScope.GetList('sb_court_members')]"
      item = {
       textbox = {
        datacontext = "[Scope.GetCharacter]"
        visible = "[And(Scope.GetCharacter.IsValid, GetScriptedGui('sb_court_roster_commander').IsShown(GuiScope.SetRoot(Country.MakeScope).AddScope('sb_court_country', Country.MakeScope).AddScope('sb_court_character', Character.MakeScope).End))]"
        text = "sb_court_commander_summary" autoresize = yes multiline = yes minimumsize = { 464 -1 } maximumsize = { 464 -1 }
       }
      }
     }
   }
  }
 }
 }
}
